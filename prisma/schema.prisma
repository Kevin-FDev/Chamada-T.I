generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusChamado {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
}

enum Papel {
  ADMIN
  USER
}

model Chamado {
  id        Int           @id @default(autoincrement())
  titulo    String
  descricao String?
  status    StatusChamado @default(ABERTO)
  criadoEm  DateTime      @default(now())
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(USER)
  criadoEm  DateTime @default(now())
}
